# Copia este archivo como .env.local y llena los dos valores.
# Están en el panel de Supabase, en el botón Connect de tu proyecto.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Dirección de la API de Fastify. En desarrollo déjala vacía: Vite reenvía /api
# al servidor local. Al publicar en Vercel, pon la dirección de Render.
VITE_API_URL=
