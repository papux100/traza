# Copia este archivo como .env y llena los valores.

# Puerto del servidor en tu computadora. En Render se asigna solo.
PORT=3000

# Cadena de conexión a PostgreSQL. En Supabase: botón Connect, pestaña de
# cadenas de conexión, opción "Session pooler". Reemplaza [YOUR-PASSWORD] por
# la contraseña de la base de datos que guardaste al crear el proyecto.
DATABASE_URL=postgresql://postgres.tu-proyecto:TU-CONTRASEÑA@aws-0-region.pooler.supabase.com:5432/postgres

# Para verificar las sesiones de los usuarios (los mismos dos valores del frontend).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Direcciones desde las que el navegador puede llamar a esta API, separadas por comas.
ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:4173
